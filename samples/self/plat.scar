when linux
	def linux_only_function()
		@puts("sup")
	end
end

when darwin
	def some_func()
		@puts("hellew")
	end
end

pub def main()
	when posix
		@puts("hi posix")
	end
	when linux
		@puts("hi linux")
		linux_only_function()
	end
	when windows
		@puts("boo")
	end
	when darwin
		@puts("hi darwin")
		some_func()
	end
	when dragonflybsd
		@puts("hi")
	end
	when openbsd
		@puts("hello")
	end
	when freebsd
		@puts("sup")
	end
	when redox
		@puts("hellooo")
	end
end

