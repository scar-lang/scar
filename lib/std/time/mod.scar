val allocators = use("std/allocators")
val str = use("std/string")

extern "time.h"

def unsupported_platform[T]() T|error
	return error("std/time is not supported on this platform yet")
end

pub type DateTime
	year  i32
	month i32  
	day   i32  
	hour  i32  
	min   i32  
	sec   i32  
end

val DAYS_IN_MONTH [2][12]i32 = [
	[31, 28, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31],
	[31, 29, 31, 30, 31, 30, 31, 31, 30, 31, 30, 31]
]

pub def is_leap_year(year i32) bool
	if (year % 400) == 0
		return true
	end
	if (year % 100) == 0
		return false
	end
	return (year % 4) == 0
end

def write_dec2(buf mut(ref(u8)), pos usize, value i32)
	@deref(@add(buf, pos))     = (value / 10) as u8 + '0' as u8
	@deref(@add(buf, pos + 1)) = (value % 10) as u8 + '0' as u8
end

def write_dec3(buf mut(ref(u8)), pos usize, value i32)
	@deref(@add(buf, pos))     = (value / 100) as u8        + '0' as u8
	@deref(@add(buf, pos + 1)) = ((value / 10) % 10) as u8  + '0' as u8
	@deref(@add(buf, pos + 2)) = (value % 10) as u8         + '0' as u8
end

def write_dec4(buf mut(ref(u8)), pos usize, value i32)
	@deref(@add(buf, pos))     = (value / 1000) as u8        + '0' as u8
	@deref(@add(buf, pos + 1)) = ((value / 100) % 10) as u8  + '0' as u8
	@deref(@add(buf, pos + 2)) = ((value / 10)  % 10) as u8  + '0' as u8
	@deref(@add(buf, pos + 3)) = (value % 10) as u8          + '0' as u8
end

pub def format_timestamp[A: allocators.BumpAllocator](
	ac ref(A),
	ts i64
) ref(u8)|error
	val secs i64 = ts / 1000000000 as i64
	var year i64 = 1970 as i64
	var days i64 = secs / 86400 as i64

	for days >= days_in_year(year)
		days = days - days_in_year(year)
		year++
	end

	val is_leap bool = is_leap_year(year as i32)
	var month i32 = 1
	for month <= 12
		if days < days_in_month(is_leap, month) as i64
			break
		end
		days = days - days_in_month(is_leap, month) as i64
		month++
	end

	val secs_of_day i64 = secs % 86400 as i64
	val hour i32 = (secs_of_day / 3600 as i64) as i32
	val min  i32 = ((secs_of_day % 3600 as i64) / 60 as i64) as i32
	val sec  i32 = (secs_of_day % 60 as i64) as i32
	val ms   i32 = ((ts % 1000000000 as i64) / 1000000 as i64) as i32
	val day  i32 = (days + 1 as i64) as i32
	var buf [24]u8 = @zeroed()
	var b mut(ref(u8)) = @as_mut(@add(@bitcast(buf, ref(void)), 0))

	write_dec4(b, 0,  year as i32)
	@deref(@add(b, 4))  = '-' as u8
	write_dec2(b, 5,  month)
	@deref(@add(b, 7))  = '-' as u8
	write_dec2(b, 8,  day)
	@deref(@add(b, 10)) = 'T' as u8
	write_dec2(b, 11, hour)
	@deref(@add(b, 13)) = ':' as u8
	write_dec2(b, 14, min)
	@deref(@add(b, 16)) = ':' as u8
	write_dec2(b, 17, sec)
	@deref(@add(b, 19)) = '.' as u8
	write_dec3(b, 20, ms)

	var out ref(void) = A.alloc(ac, 24 as usize)?
	@memcpy(out, @addr(buf), 23 as usize)
	@deref(@add(out, 23 as usize)) = 0 as u8

	return out as mut(ref(u8))
end

def days_in_year(year i64) i64
	if (year % 4 as i64) == 0 as i64 && ((year % 100 as i64) != 0 as i64 || (year % 400 as i64) == 0 as i64)
		return 366 as i64
	end
	return 365 as i64
end

def days_in_month(leap bool, month i32) i32
	match month
		1 =>  ( return 31 )
		2 => (
			if leap
				return 29
			else
				return 28
			end 
		)
		3 =>  ( return 31 )
		4 =>  ( return 30 )
		5 =>  ( return 31 )
		6 =>  ( return 30 )
		7 =>  ( return 31 )
		8 =>  ( return 31 )
		9 =>  ( return 30 )
		10 => ( return 31 )
		11 => ( return 30 )
		12 => ( return 31 )
		_ => ( return 30 )
	end
end

pub def DateTime.from_epoch(unix_secs i64) DateTime
	val (
		secs i64 = unix_secs
		s_per_min i64 = 60 as i64
		s_per_hour i64 = 3600 as i64
		s_per_day i64 = 86400 as i64
		sec  i32 = (secs % s_per_min) as i32
		min  i32 = ((secs % s_per_hour) / s_per_min) as i32
		hour i32 = ((secs % s_per_day) / s_per_hour) as i32
	)
	
	var days i64 = secs / s_per_day

	var year i32 = 1970
	for
		var diy i64 = 366 as i64
		if !is_leap_year(year)
			diy = 365 as i64
		end
		if days < diy
			break
		end
		days = days - diy
		year++
	end

	var leap i32 = 0
	if is_leap_year(year)
		leap = 1
	end

	var month i32 = 1
	for month <= 12
		var dim i64 = DAYS_IN_MONTH[leap][month - 1] as i64
		if days < dim
			break
		end
		days = days - dim
		month++
	end

	val day i32 = (days + 1 as i64) as i32

	return DateTime(
		year:  year,
		month: month,
		day:   day,
		hour:  hour,
		min:   min,
		sec:   sec
	)
end

pub def DateTime.to_epoch(dt ref(DateTime)) i64
	var days i64 = 0 as i64
	var y i32 = 1970
	for y < dt.year
		if is_leap_year(y)
			days = days + 366 as i64
		else
			days = days + 365 as i64
		end
		y++
	end

	var leap i32 = 0
	if is_leap_year(dt.year)
		leap = 1
	end

	var m i32 = 1
	for m < dt.month
		days = days + (DAYS_IN_MONTH[leap][m - 1] as i64)
		m++
	end

	days = days + ((dt.day - 1) as i64)

	return (days * 86400 as i64 + (dt.hour as i64) * 3600 as i64 + (dt.min  as i64) * 60 as i64 + (dt.sec  as i64))
end

pub def DateTime.is_valid(dt ref(DateTime)) bool
	if dt.month < 1 || dt.month > 12
		return false
	end
	if dt.hour < 0 || dt.hour > 23
		return false
	end
	if dt.min < 0 || dt.min > 59
		return false
	end
	if dt.sec < 0 || dt.sec > 59
		return false
	end
	var leap i32 = 0
	if is_leap_year(dt.year)
		leap = 1
	end
	val max_day i32 = DAYS_IN_MONTH[leap][dt.month - 1]
	return dt.day >= 1 && dt.day <= max_day
end

when posix
	extern def time(t mut(ref(i64))) i64 :: "time"

	extern type Timespec
		tv_sec  i64
		tv_nsec i64
	end

	extern type Tm
		tm_sec   i32
		tm_min   i32
		tm_hour  i32
		tm_mday  i32
		tm_mon   i32
		tm_year  i32
		tm_wday  i32
		tm_yday  i32
		tm_isdst i32
	end

	extern def clock_gettime(clk_id i32, ts mut(ref(Timespec))) i32 :: "clock_gettime"
	extern def localtime(t ref(i64)) ref(Tm) :: "localtime"
	extern def clock() i64 :: "clock"

	extern def nanosleep(tv_sec ref(i64), tv_nsec ref(i64)) i32 :: "nanosleep"

	pub def now() i64
		var ts Timespec = @zeroed()
		clock_gettime(0, @as_mut(@addr(ts)))
		return ts.tv_sec * 1000000000 as i64 + ts.tv_nsec
	end

	pub def epoch() i64
		return time(none)
	end

	pub def clock_time() i64
		return clock()
	end

	pub def sleep_ms(milliseconds u64) void|error
		var tv_sec  i64 = (milliseconds / 1000 as u64) as i64
		var tv_nsec i64 = ((milliseconds % 1000 as u64) * 1000000 as u64) as i64
		if nanosleep(@addr(tv_sec), @addr(tv_nsec)) != 0
			return error("sleep failed")
		end
	end

	pub def sleep_seconds(seconds f64) void|error
		var tv_sec  i64 = seconds as i64
		var tv_nsec i64 = ((seconds - (tv_sec as f64)) * 1000000000.0) as i64
		if nanosleep(@addr(tv_sec), @addr(tv_nsec)) != 0
			return error("sleep failed")
		end
	end

	pub def now_datetime() DateTime
		var t i64 = epoch()
		var tm ref(Tm) = localtime(@addr(t))
		return DateTime(
			year:  (tm.tm_year + 1900) as i32,
			month: (tm.tm_mon + 1) as i32,
			day:   (tm.tm_mday) as i32,
			hour:  (tm.tm_hour) as i32,
			min:   (tm.tm_min) as i32,
			sec:   (tm.tm_sec) as i32
		)
	end
end

when windows
	extern "windows.h"

	extern def GetTickCount64() u64 :: "GetTickCount64"
	extern def QueryPerformanceCounter(freq mut(ref(i64))) i64 :: "QueryPerformanceCounter"
	extern def QueryPerformanceFrequency(freq mut(ref(i64))) i64 :: "QueryPerformanceCounter"
	extern def Sleep(dwMilliseconds u32) void :: "Sleep"
	extern def GetSystemTimeAsFileTime(lpSystemTimeAsFileTime mut(ref(i64))) void :: "GetSystemTimeAsFileTime"

	pub def now() i64
		var ft i64 = 0 as i64
		GetSystemTimeAsFileTime(@addr(ft))
		var unix_epoch_offset i64 = 11644473600 as i64
		unix_epoch_offset = unix_epoch_offset * 10000000 as i64
		return (ft / 10000000 as i64) - unix_epoch_offset
	end

	pub def epoch() i64
		return now()
	end

	pub def clock_time() i64
		return (GetTickCount64() as i64) * 1000 as i64
	end

	pub def sleep_ms(milliseconds u64) void|error
		Sleep(milliseconds as u32)
	end

	pub def sleep_seconds(seconds f64) void|error
		Sleep((seconds * 1000.0) as u32)
	end

	pub def now_datetime() DateTime
		return DateTime.from_epoch(epoch())
	end
end

when redox
	pub def now() i64|error
		return unsupported_platform[i64]()
	end

	pub def epoch() i64|error
		return unsupported_platform[i64]()
	end

	pub def clock_time() i64|error
		return unsupported_platform[i64]()
	end

	pub def sleep_ms(milliseconds u64) void|error
		return unsupported_platform[void]()
	end

	pub def sleep_seconds(seconds f64) void|error
		return unsupported_platform[void]()
	end
end


test "time functions work"
	val start = clock_time()
	assert start > 0 as i64
	sleep_ms(10 as u64)?
	val elapsed = clock_time() - start
	assert elapsed > 0 as i64
end

test "epoch returns reasonable value"
	val t = epoch()
	assert t > 1609459200 as i64  
end

test "is_leap_year works"
	assert is_leap_year(2000)
	assert is_leap_year(2024)
	assert !is_leap_year(1900)
	assert !is_leap_year(2023)
end

test "DateTime.from_epoch works"
	val dt = DateTime.from_epoch(1710502245 as i64)
	assert dt.year  == 2024
	assert dt.month == 3
	assert dt.day   == 15
	assert dt.hour  == 11
	assert dt.min   == 30
	assert dt.sec   == 45
end

test "DateTime.to_epoch round-trips"
	var dt = DateTime(
		year:  2024,
		month: 3,
		day:   15,
		hour:  11,
		min:   30,
		sec:   45
	)
	assert DateTime.to_epoch(@addr(dt)) == 1710502245 as i64
end

test "DateTime.is_valid works"
	var good = DateTime(year: 2024, month: 2, day: 29, hour: 0, min: 0, sec: 0)
	assert DateTime.is_valid(@addr(good))

	var bad_month = DateTime(year: 2024, month: 13, day: 1, hour: 0, min: 0, sec: 0)
	assert !DateTime.is_valid(@addr(bad_month))

	var bad_leap = DateTime(year: 2023, month: 2, day: 29, hour: 0, min: 0, sec: 0)
	assert !DateTime.is_valid(@addr(bad_leap))
end

test "epoch and from_epoch are consistent"
	val t = epoch()
	var dt = DateTime.from_epoch(t)
	assert DateTime.is_valid(@addr(dt))
	assert dt.year >= 2024
end

test "format_timestamp works"
	var ac = allocators.Arena.new(1024 as usize)?

	val ts1 = 0 as i64
	val formatted1 = format_timestamp[_](@addr(ac), ts1)?
	assert str.len(formatted1) > 0 as usize

	val ts2 = 1704067200000000000 as i64
	format_timestamp[_](@addr(ac), ts2)?

	allocators.Arena.destroy(@addr(ac))
end
