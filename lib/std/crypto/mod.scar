val str = use("std/string")
val allocators = use("std/allocators")

def crypto_error[T](message ref(u8)) T|error
	return error(message)
end

pub def constant_time_eql(
	x ref(u8),
	y ref(u8),
	len usize
) bool
	if len == 0 as usize
		return true
	end

	guard x != none && y != none else
		return false
	end

	var diff usize = 0 as usize

	for var i = 0 .. len as i32
		var bx usize = @deref(@add(x, i)) as usize
		var by usize = @deref(@add(y, i)) as usize
		diff = diff | (bx ^ by)
	end

	return diff == 0 as usize
end

pub def constant_time_str_eql(x ref(u8), y ref(u8)) bool
	guard x != none && y != none else
		return false
	end

	val len_x usize = str.len(x)
	val len_y usize = str.len(y)
	var limit usize = len_x

	if len_y > limit
		limit = len_y
	end

	var diff usize = len_x ^ len_y

	for var i = 0 .. limit as i32
		var bx usize = 0 as usize
		var by usize = 0 as usize

		if i < len_x
			bx = @deref(@add(x, i)) as usize
		end

		if i < len_y
			by = @deref(@add(y, i)) as usize
		end

		diff = diff | (bx ^ by)
	end

	return diff == 0 as usize
end

when windows
	extern "stdlib.h"

	extern def rand_s(value_out mut(ref(u32))) i32 :: "rand_s"

	pub def fill_random(buffer mut(ref(u8)), len usize) void|error
		if len == 0 as usize
			return
		end

		guard buffer != none else
			return crypto_error[void]("secure random buffer is null")
		end

		var offset usize = 0 as usize

		for offset < len
			var value u32 = 0 as u32
			if rand_s(@as_mut(@addr(value))) != 0
				return crypto_error[void]("failed to read secure random bytes")
			end

			var remaining usize = len - offset
			var chunk usize = 4 as usize

			if remaining < chunk
				chunk = remaining
			end

			@memcpy(@add(buffer, offset), @addr(value), chunk)
			offset += chunk
		end
	end
end

when posix
	when linux
		extern "sys/random.h"

		extern def getrandom(
			buffer mut(ref(u8)),
			len usize,
			flags u32
		) isize :: "getrandom"

		def platform_fill_random(
			buffer mut(ref(u8)),
			len usize
		) void|error
			var offset usize = 0 as usize

			for offset < len
				var read isize = getrandom(
					@add(buffer, offset),
					len - offset,
					0 as u32
				)

				if read < 0
					return crypto_error[void](
						"failed to read secure random bytes"
					)
				end

				if read == 0
					return crypto_error[void](
						"secure random source returned no data"
					)
				end

				offset += read as usize
			end
		end
	end

	when android
		extern "sys/random.h"

		extern def getrandom(
			buffer mut(ref(u8)),
			len usize,
			flags u32
		) isize :: "getrandom"

		def platform_fill_random(
			buffer mut(ref(u8)),
			len usize
		) void|error
			var offset usize = 0 as usize

			for offset < len
				var read isize = getrandom(
					@add(buffer, offset),
					len - offset,
					0 as u32
				)

				if read < 0
					return crypto_error[void](
						"failed to read secure random bytes"
					)
				end

				if read == 0
					return crypto_error[void](
						"secure random source returned no data"
					)
				end

				offset += read as usize
			end
		end
	end

	when darwin
		extern def arc4random_buf(
			buffer mut(ref(u8)),
			len usize
		) void :: "arc4random_buf"

		def platform_fill_random(
			buffer mut(ref(u8)),
			len usize
		) void|error
			arc4random_buf(buffer, len)
		end
	end

	when ios
		extern def arc4random_buf(
			buffer mut(ref(u8)),
			len usize
		) void :: "arc4random_buf"

		def platform_fill_random(
			buffer mut(ref(u8)),
			len usize
		) void|error
			arc4random_buf(buffer, len)
		end
	end

	when freebsd
		extern def arc4random_buf(
			buffer mut(ref(u8)),
			len usize
		) void :: "arc4random_buf"

		def platform_fill_random(
			buffer mut(ref(u8)),
			len usize
		) void|error
			arc4random_buf(buffer, len)
		end
	end

	when openbsd
		extern def arc4random_buf(
			buffer mut(ref(u8)),
			len usize
		) void :: "arc4random_buf"

		def platform_fill_random(
			buffer mut(ref(u8)),
			len usize
		) void|error
			arc4random_buf(buffer, len)
		end
	end

	when netbsd
		extern def arc4random_buf(
			buffer mut(ref(u8)),
			len usize
		) void :: "arc4random_buf"

		def platform_fill_random(
			buffer mut(ref(u8)),
			len usize
		) void|error
			arc4random_buf(buffer, len)
		end
	end

	when dragonflybsd
		extern def arc4random_buf(
			buffer mut(ref(u8)),
			len usize
		) void :: "arc4random_buf"

		def platform_fill_random(
			buffer mut(ref(u8)),
			len usize
		) void|error
			arc4random_buf(buffer, len)
		end
	end

	pub def fill_random(buffer mut(ref(u8)), len usize) void|error
		if len == 0 as usize
			return
		end

		guard buffer != none else
			return crypto_error[void]("secure random buffer is null")
		end

		return platform_fill_random(buffer, len)
	end
end

when redox
	pub def fill_random(buffer mut(ref(u8)), len usize) void|error
		return crypto_error[void](
			"std/crypto is not supported on this platform yet"
		)
	end
end


pub def random_u32() u32|error
	var value u32 = 0 as u32
	fill_random(@as_mut(@addr(value)) as mut(ref(u8)), 4 as usize)?
	return value
end

pub def random_u64() u64|error
	var value u64 = 0 as u64
	fill_random(@as_mut(@addr(value)) as mut(ref(u8)), 8 as usize)?
	return value
end

pub def fnv1a_32(data ref(u8), len usize) u32
	## FNV-1a hash (32-bit) - fast, non-cryptographic, suitable for hash tables
	var hash u32 = 2166136261 as u32
	for var i = 0 .. len as i32
		var byte u32 = @deref(@add(data, i)) as u32
		hash = hash ^ byte
		hash = hash * 16777619 as u32
	end
	return hash
end

pub def fnv1a_64(data ref(u8), len usize) u64
	## FNV-1a hash (64-bit)
	var hash u64 = 14695981039346656037 as u64
	for var i = 0 .. len as i32
		var byte u64 = @deref(@add(data, i)) as u64
		hash = hash ^ byte
		hash = hash * 1099511628211 as u64
	end
	return hash
end

pub def fnv1a_str(s ref(u8)) u32
	## Hash a null-terminated string with FNV-1a (32-bit)
	guard s != none else
		return 0 as u32
	end
	return fnv1a_32(s, str.len(s))
end

test "constant time byte compare works"
	assert constant_time_eql("scar", "scar", 4 as usize)
	assert !constant_time_eql("scar", "scan", 4 as usize)
	assert !constant_time_eql("scars", "scare", 5 as usize)
end

test "constant time string compare works"
	assert constant_time_str_eql("scar", "scar")
	assert !constant_time_str_eql("scar", "scan")
	assert !constant_time_str_eql("scar", "scar-lang")
end

test "secure random generation works"
	var first mut(ref(u8)) = @alloc(32 as usize)
	var second mut(ref(u8)) = @alloc(32 as usize)

	fill_random(first, 32 as usize)?
	fill_random(second, 32 as usize)?

	var saw_non_zero bool = false
	var saw_difference bool = false

	for var i = 0 .. 32
		var left u8 = @deref(@add(first, i))
		var right u8 = @deref(@add(second, i))

		if left != 0 as u8 || right != 0 as u8
			saw_non_zero = true
		end

		if left != right
			saw_difference = true
		end
	end

	assert saw_non_zero
	assert saw_difference
	assert random_u32()? != 0 as u32 || random_u64()? != 0 as u64

	@free(first)
	@free(second)
end

def hex_char(nibble u8) u8
	if nibble < 10 as u8
		return '0' as u8 + nibble
	end
	return 'a' as u8 + (nibble - 10 as u8)
end

def write_hex_byte(buf mut(ref(u8)), offset usize, byte u8)
	@deref(@add(buf, offset))     = hex_char(byte >> 4 as u8)
	@deref(@add(buf, offset + 1)) = hex_char(byte & 0x0f as u8)
end

## Generate a UUID v4 string per RFC 4122.
## Returns a null-terminated string allocated from the given allocator.
## Format: xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx (36 chars + null)
pub def uuid_v4[A: allocators.BumpAllocator](ac ref(A)) ref(u8)|error
	var bytes [16]u8 = @zeroed()
	fill_random(@as_mut(@add(@bitcast(bytes, ref(void)), 0)), 16 as usize)?

	bytes[6] = (bytes[6] & 0x0f as u8) | 0x40 as u8
	bytes[8] = (bytes[8] & 0x3f as u8) | 0x80 as u8

	var out ref(void) = A.alloc(ac, 37 as usize)?
	var buf mut(ref(u8)) = out as mut(ref(u8))

	val positions [16]i32 = [0, 2, 4, 6, 9, 11, 14, 16, 19, 21, 24, 26, 28, 30, 32, 34]
	for var i = 0 .. 16
		write_hex_byte(buf, positions[i] as usize, bytes[i])
	end

	val dashes [4]i32 = [8, 13, 18, 23]
	for var i = 0 .. 4
		@deref(@add(buf, dashes[i])) = '-' as u8
	end

	@deref(@add(buf, 36 as usize)) = 0 as u8
	return buf as ref(u8)
end

test "uuid_v4 format is valid"
	var ac = allocators.Arena.new(256 as usize)?
	var id ref(u8) = uuid_v4[_](@addr(ac))?

	assert str.len(id) == 36 as usize
	assert @deref(@add(id, 8))  == '-' as u8
	assert @deref(@add(id, 13)) == '-' as u8
	assert @deref(@add(id, 18)) == '-' as u8
	assert @deref(@add(id, 23)) == '-' as u8
	assert @deref(@add(id, 14)) == '4' as u8

	val variant u8 = @deref(@add(id, 19))
	assert variant == '8' as u8 || variant == '9' as u8 || variant == 'a' as u8 || variant == 'b' as u8

	allocators.Arena.destroy(@addr(ac))
end

test "uuid_v4 generates unique values"
	var ac = allocators.Arena.new(256 as usize)?

	var a ref(u8) = uuid_v4[_](@addr(ac))?
	var b ref(u8) = uuid_v4[_](@addr(ac))?

	assert !str.eql(a, b)

	allocators.Arena.destroy(@addr(ac))
end
