val str = use("std/string")
val allocators = use("std/allocators")

val SCALE i64 = 1000
val ESCAPE i64 = 4000000

type Complex
    re i64
    im i64
end

def make_complex(re i64, im i64) Complex
    return Complex(
        re: re,
        im: im
    )
end

def c_add(a Complex, b Complex) Complex
    return Complex(
        re: a.re + b.re,
        im: a.im + b.im
    )
end

def c_mul(a Complex, b Complex) Complex
    return Complex(
        re: (a.re * b.re - a.im * b.im) / SCALE,
        im: (a.re * b.im + a.im * b.re) / SCALE
    )
end

def c_mag2(a Complex) i64
    return (a.re * a.re + a.im * a.im)
end

def mandelbrot_iter(c Complex, max_iter i32) i32
    var z = make_complex(0, 0)

    for var i = 0 .. max_iter
        if c_mag2(z) > ESCAPE
            return i
        end

        z = c_add(c_mul(z, z), c)
    end

    return max_iter
end

def ascii_for(iter i32, max_iter i32) ref(u8)
    if iter == max_iter
        return "@"
    end
    if iter > 80
        return "%"
    end
    if iter > 60
        return "#"
    end
    if iter > 40
        return "*"
    end
    if iter > 25
        return "+"
    end
    if iter > 12
        return "="
    end
    if iter > 5
        return "-"
    end
    if iter > 1
        return ":"
    end
    return "."
end

def render_mandelbrot(width i32, height i32, max_iter i32) void|error
    var ac = allocators.Arena.new(8192 as usize)?
    defer
        allocators.Arena.destroy(@addr(ac))
    end

    for var iy = 0 .. height
        var line = ""

        for var ix = 0 .. width
            val re = ((ix * 3500) / width - 2200) as i64
            val im = ((iy * 2400) / height - 1200) as i64
            val iter = mandelbrot_iter(make_complex(re, im), max_iter)

            line = str.rconcat[_](ac, line, ascii_for(iter, max_iter))?
        end

        @puts(line)
        allocators.Arena.reset(@addr(ac))
    end
end

pub def main() void
    @puts("mandelbrot starting...")

    render_mandelbrot(80, 40, 100)

    @puts("done")
end
