val allocators = use("std/allocators")
val str = use("std/string")

pub type DirEntry
	name ref(u8)
	path ref(u8)
	is_file bool
	is_dir bool
end

def unsupported_fs[T]() T|error
	return error("std/fs is not supported on this platform yet")
end

def io_error[T](message ref(u8)) T|error
	return error(message)
end

def is_sep(ch u8) bool
	when windows
		return ch == '/' || ch == '\\'
	end

	return ch == '/'
end

def root_len(path ref(u8)) usize
	guard path != none else
		return 0 as usize
	end

	val len_path usize = str.len(path)
	if len_path == 0 as usize
		return 0 as usize
	end

	when windows
		var first u8 = @deref(path)
		if is_sep(first)
			return 1 as usize
		end

		if len_path >= 3 as usize
			var second u8 = @deref(@add(path, 1 as usize))
			var third u8 = @deref(@add(path, 2 as usize))
			if (
				(
					first >= 'A' as u8 &&
					first <= 'Z' as u8
				) ||
				(
					first >= 'a' as u8 &&
					first <= 'z' as u8
				)
			) &&
			second == ':' as u8 &&
			is_sep(third)
				return 3 as usize
			end
		end

		return 0 as usize
	end

	if is_sep(@deref(path))
		return 1 as usize
	end

	return 0 as usize
end

def path_sep() u8
	when windows
		return '\\' as u8
	end

	return '/' as u8
end

def copy_bytes[A: allocators.BumpAllocator](
	ac ref(A),
	src ref(u8),
	count usize
) ref(u8)|error
	var out ref(void) = A.alloc(ac, count + 1 as usize)?

	if count > 0 as usize
		@memcpy(out, src, count)
	end

	@deref(@as_mut(@add(out, count))) = 0 as u8
	return out as ref(u8)
end

def copy_string[A: allocators.BumpAllocator](
	ac ref(A),
	src ref(u8)
) ref(u8)|error
	guard src != none else
		return none
	end

	return copy_bytes[A](ac, src, str.len(src))
end

def trimmed_len(path ref(u8)) usize
	var out usize = str.len(path)
	val root usize = root_len(path)

	for out > root && is_sep(@deref(@add(path, out - 1 as usize)))
		out--
	end

	return out
end

def basename_start(path ref(u8), nd usize) usize
	var start usize = 0
	var i usize = 0

	for i < nd
		if is_sep(@deref(@add(path, i))) && i + 1 as usize < nd
			start = i + 1 as usize
		end
		i++
	end

	return start
end

def find_extension_dot(path ref(u8), start usize, nd usize) isize
	var i usize = nd

	for i > start
		i--

		if @deref(@add(path, i)) == '.'
			if i == start
				return -1 as isize
			end
			return i as isize
		end
	end

	return -1 as isize
end

pub def join[A: allocators.BumpAllocator](
	ac ref(A),
	a ref(u8),
	b ref(u8)
) ref(u8)|error
	guard a != none else
		return copy_string[A](ac, b)
	end

	guard b != none else
		return copy_string[A](ac, a)
	end

	val len_a usize = trimmed_len(a)
	val len_b usize = str.len(b)
	var start_b usize = 0

	if is_absolute(b)
		return copy_bytes[A](ac, b, len_b)
	end

	for start_b + 1 as usize < len_b && is_sep(@deref(@add(b, start_b)))
		start_b++
	end

	if len_a == 0 as usize
		return copy_bytes[A](ac, @add(b, start_b), len_b - start_b)
	end

	if start_b >= len_b
		return copy_bytes[A](ac, a, len_a)
	end

	val needs_sep bool = !is_sep(@deref(@add(a, len_a - 1 as usize)))

	var out_len usize =	len_a +	(len_b - start_b)

	if needs_sep
		out_len++
	end

	var out ref(void) = A.alloc(ac, out_len + 1 as usize)?
	var cursor usize = 0

	@memcpy(out, a, len_a)
	cursor = len_a

	if needs_sep
		@deref(@as_mut(@add(out, cursor))) = path_sep()
		cursor++
	end

	@memcpy(
		@add(out, cursor),
		@add(b, start_b),
		len_b - start_b
	)

	cursor += len_b - start_b
	@deref(@as_mut(@add(out, cursor))) = 0 as u8

	return out as ref(u8)
end

pub def dirname[A: allocators.BumpAllocator](
	ac ref(A),
	path ref(u8)
) ref(u8)|error
	guard path != none else
		return none
	end

	val nd usize = trimmed_len(path)
	val root usize = root_len(path)

	if nd == 0 as usize
		return copy_string[A](ac, ".")
	end

	if nd == root && root > 0 as usize
		return copy_bytes[A](ac, path, root)
	end

	var i usize = nd

	for i > 0 as usize
		i--

		if is_sep(@deref(@add(path, i)))
			for i > root && is_sep(@deref(@add(path, i - 1 as usize)))
				i--
			end

			if i < root
				return copy_bytes[A](ac, path, root)
			end

			return copy_bytes[A](ac, path, i)
		end
	end

	return copy_string[A](ac, ".")
end

pub def basename[A: allocators.BumpAllocator](
	ac ref(A),
	path ref(u8)
) ref(u8)|error
	guard path != none else
		return none
	end

	val nd usize = trimmed_len(path)
	val root usize = root_len(path)

	if nd == 0 as usize
		return copy_string[A](ac, "")
	end

	if nd == root && root > 0 as usize
		return copy_bytes[A](ac, path, root)
	end

	val start usize = basename_start(path, nd)
	return copy_bytes[A](ac, @add(path, start), nd - start)
end

pub def extension[A: allocators.BumpAllocator](
	ac ref(A),
	path ref(u8)
) ref(u8)|error
	guard path != none else
		return none
	end

	val nd usize = trimmed_len(path)
	val start usize = basename_start(path, nd)
	val dot isize = find_extension_dot(path, start, nd)

	if dot < 0
		return copy_string[A](ac, "")
	end

	val offset usize = dot as usize + 1 as usize
	return copy_bytes[A](ac, @add(path, offset), nd - offset)
end

pub def strip_extension[A: allocators.BumpAllocator](
	ac ref(A),
	path ref(u8)
) ref(u8)|error
	guard path != none else
		return none
	end

	val (
		nd usize = trimmed_len(path)
		start usize = basename_start(path, nd)
		dot isize = find_extension_dot(path, start, nd)
	)
	
	if dot < 0
		return copy_bytes[A](ac, path, nd)
	end

	return copy_bytes[A](ac, path, dot as usize)
end

pub def is_absolute(path ref(u8)) bool
	if path == none
		return false
	end

	val len_path usize = str.len(path)
	if len_path == 0 as usize
		return false
	end

	if is_sep(@deref(path))
		return true
	end

	when windows
		if len_path < 3 as usize
			return false
		end

		var first u8 = @deref(path)
		var second u8 = @deref(@add(path, 1 as usize))
		var third u8 = @deref(@add(path, 2 as usize))

		return (
			(
				(
					first >= 'A' as u8 &&
					first <= 'Z' as u8
				) ||
				(
					first >= 'a' as u8 &&
					first <= 'z' as u8
				)
			) &&
			second == ':' as u8 &&
			is_sep(third)
		)
	end

	return false
end

when posix
	extern def fopen(path ref(u8), mode ref(u8)) ref(void) :: "fopen"
	extern def fclose(file ref(void)) i32 :: "fclose"
	extern def fseek(file ref(void), offset i64, whence i32) i32 :: "fseek"
	extern def ftell(file ref(void)) i64 :: "ftell"
	extern def fread(
		ptr ref(void),
		size usize,
		count usize,
		file ref(void)
	) usize :: "fread"
	extern def fwrite(
		ptr ref(void),
		size usize,
		count usize,
		file ref(void)
	) usize :: "fwrite"
	extern def mkdir(path ref(u8), mode i32) i32 :: "mkdir"
	extern def rmdir(path ref(u8)) i32 :: "rmdir"
	extern def opendir(path ref(u8)) ref(void) :: "opendir"
	extern def readdir(dir ref(void)) ref(void) :: "readdir"
	extern def closedir(dir ref(void)) i32 :: "closedir"
	extern def stat(path ref(u8), buf ref(void)) i32 :: "stat"
	extern def access(path ref(u8), mode i32) i32 :: "access"
	extern def unlink(path ref(u8)) i32 :: "unlink"
	extern def strerror(code i32) ref(u8) :: "strerror"
	extern def system(command ref(u8)) i32 :: "system"

	when linux | android
		extern def __errno_location() mut(ref(i32)) :: "__errno_location"

		def errno_ptr() mut(ref(i32))
			return __errno_location()
		end
	end

	when darwin | ios | freebsd | openbsd | netbsd | dragonflybsd
		extern def __error() mut(ref(i32)) :: "__error"

		def errno_ptr() mut(ref(i32))
			return __error()
		end
	end

	def last_errno_message(fallback ref(u8)) ref(u8)
		val ptr = errno_ptr()
		guard ptr != none else
			return fallback
		end
		return strerror(@deref(ptr))
	end

	def heap_alloc(size usize) ref(u8)|error
		var mem ref(u8) = @alloc(size) as mut(ref(u8))
		if mem == none
			return error("heap allocation failed")
		end
		return mem
	end

	def stat_mode_offset() usize
		when darwin | ios
			return 4
		end
		when freebsd | openbsd | netbsd | dragonflybsd
			return 4
		end
		return 24
	end

	def dirent_type_offset() usize
		when darwin | ios | freebsd | openbsd | netbsd | dragonflybsd
			return 20
		end
		return 18
	end

	def dirent_name_offset() usize
		when darwin | ios | freebsd | openbsd | netbsd | dragonflybsd
			return 21
		end
		return 19
	end

	def dirent_type(entry ref(void)) u8
		return @deref(@add(entry, dirent_type_offset()) as ref(u8))
	end

	def dirent_name(entry ref(void)) ref(u8)
		return @add(entry, dirent_name_offset()) as ref(u8)
	end

	def allocate_line[A: allocators.BumpAllocator](
		ac ref(A),
		line ref(u8)
	) ref(u8)|error
		return copy_bytes[A](ac, line, str.len(line))
	end

	pub def read_text[A: allocators.BumpAllocator](
		ac ref(A),
		path ref(u8)
	) ref(u8)|error
		var file = fopen(path, "rb")
		if file == none
			return io_error[ref(u8)](
				last_errno_message("failed to open file")
			)
		end

		if fseek(file, 0, 2) != 0
			fclose(file)
			return io_error[ref(u8)](
				last_errno_message("failed to seek file")
			)
		end

		val size i64 = ftell(file)
		if size < 0
			fclose(file)
			return io_error[ref(u8)](
				last_errno_message("failed to read file size")
			)
		end

		if fseek(file, 0, 0) != 0
			fclose(file)
			return io_error[ref(u8)](
				last_errno_message("failed to rewind file")
			)
		end

		var out ref(void) = A.alloc(ac, size as usize + 1 as usize)?
		val read_count usize = fread(out, 1 as usize, size as usize, file)

		fclose(file)

		if read_count != size as usize
			return io_error[ref(u8)](
				last_errno_message("failed to read file")
			)
		end

		@deref(@as_mut(@add(out, read_count))) = 0 as u8
		return out as ref(u8)
	end

	pub def write_text(path ref(u8), data ref(u8)) void|error
		var file = fopen(path, "wb")
		if file == none
			return io_error[void](
				last_errno_message("failed to open file")
			)
		end

		val len_data usize = str.len(data)
		val wrote usize = fwrite(data as ref(void), 1 as usize, len_data, file)

		if fclose(file) != 0
			return io_error[void](
				last_errno_message("failed to close file")
			)
		end

		if wrote != len_data
			return io_error[void](
				last_errno_message("failed to write file")
			)
		end
	end

	pub def read_dir[A: allocators.BumpAllocator](
		ac ref(A),
		path ref(u8)
	) list[DirEntry]|error
		var dir = opendir(path)
		if dir == none
			return io_error[list[DirEntry]](
				last_errno_message("failed to read directory")
			)
		end

		var entries list[DirEntry] = []
		var entry ref(void) = readdir(dir)

		for entry != none
			var name ref(u8) = dirent_name(entry)

			if str.eql(name, ".") || str.eql(name, "..")
				entry = readdir(dir)
				continue
			end

			var kind_dir bool = dirent_type(entry) == 4
			var name_copy = allocate_line[A](ac, name)?
			var full_path = join[A](ac, path, name_copy)?

			@append(
				entries,
				DirEntry(
					name: name_copy,
					path: full_path,
					is_file: !kind_dir,
					is_dir: kind_dir
				)
			)

			entry = readdir(dir)
		end

		if closedir(dir) != 0
			return io_error[list[DirEntry]]("failed to read directory")
		end

		return entries
	end

	pub def create_dir(path ref(u8)) void|error
		if mkdir(path, 511) != 0
			return io_error[void](
				last_errno_message("failed to create directory")
			)
		end
	end

	pub def create_dir_all(path ref(u8)) void|error
		guard path != none && str.len(path) > 0 as usize else
			return io_error[void]("failed to create directory")
		end

		if access(path, 0) == 0
			return
		end

		val len_path usize = str.len(path)
		var copy ref(u8) = heap_alloc(len_path + 1 as usize)?
		@memcpy(copy as ref(void), path as ref(void), len_path + 1 as usize)
		var i usize = root_len(copy)

		for i < len_path
			if is_sep(@deref(@add(copy, i)))
				@deref(@as_mut(@add(copy, i))) = 0 as u8

				if access(copy, 0) != 0
					if mkdir(copy, 511) != 0
						var saved u8 = '/'
						@free(copy)
						return io_error[void](
							last_errno_message("failed to create directory")
						)
					end
				end

				@deref(@as_mut(@add(copy, i))) = '/' as u8
			end
			i++
		end

		if mkdir(copy, 511) != 0
			@free(copy)
			return io_error[void](
				last_errno_message("failed to create directory")
			)
		end

		@free(copy)
	end

	pub def remove_dir(path ref(u8)) void|error
		if rmdir(path) != 0
			return io_error[void](
				last_errno_message("failed to remove directory")
			)
		end
	end

	pub def remove_dir_all(path ref(u8)) void|error
		if path == none || access(path, 0) != 0
			return
		end

		var dir = opendir(path)
		if dir == none
			return io_error[void](
				last_errno_message("failed to remove directory tree")
			)
		end

		var entry ref(void) = readdir(dir)
		val len_path usize = str.len(path)

		for entry != none
			var name ref(u8) = dirent_name(entry)

			if str.eql(name, ".") || str.eql(name, "..")
				entry = readdir(dir)
				continue
			end

			var len_name usize = str.len(name)
			var full ref(u8) = heap_alloc(len_path + 1 as usize + len_name + 1 as usize)?
			@memcpy(full as ref(void), path as ref(void), len_path)
			@deref(@as_mut(@add(full, len_path))) = '/' as u8
			@memcpy(
				@add(full, len_path + 1 as usize) as ref(void),
				name as ref(void),
				len_name + 1 as usize
			)

			if dirent_type(entry) == 4 || dirent_type(entry) == 0
				remove_dir_all(full)?
			else
				if unlink(full) != 0
					@free(full)
					closedir(dir)
					return io_error[void](
						last_errno_message("failed to remove directory tree")
					)
				end
			end

			@free(full)
			entry = readdir(dir)
		end

		closedir(dir)
		remove_dir(path)?
	end

	pub def remove_file(path ref(u8)) void|error
		guard path != none else
			return io_error[void]("got a null path")
		end
		if unlink(path) != 0
			return io_error[void](
				last_errno_message("failed to remove file")
			)
		end
	end

	pub def exists(path ref(u8)) bool
		guard path != none else
			return false
		end
		return access(path, 0) == 0
	end

	pub def is_file(path ref(u8)) bool
		guard path != none else
			return false
		end

		match heap_alloc(144 as usize)
			ok raw_buf => (
				if stat(path, raw_buf as ref(void)) != 0
					@free(raw_buf)
					return false
				end

				val mode u32 = @deref(@add(raw_buf, stat_mode_offset()) as ref(u32))
				@free(raw_buf)
				return (mode & 61440) == 32768
			)
			error _ => (
				return false
			)
		end
	end

	pub def is_dir(path ref(u8)) bool
		guard path != none else
			return false
		end

		match heap_alloc(144 as usize)
			ok raw_buf => (
				if stat(path, raw_buf as ref(void)) != 0
					@free(raw_buf)
					return false
				end

				val mode u32 = @deref(@add(raw_buf, stat_mode_offset()) as ref(u32))
				@free(raw_buf)
				return (mode & 61440) == 16384
			)
			error _ => (
				return false
			)
		end
	end
end

when windows
	extern "windows.h"

	extern def SetLastError(code u32) void :: "SetLastError"
	extern def GetLastError() u32 :: "GetLastError"
	extern def GetFileAttributesA(path ref(u8)) u32 :: "GetFileAttributesA"
	extern def CreateDirectoryA(path ref(u8), attrs ref(void)) i32 :: "CreateDirectoryA"
	extern def RemoveDirectoryA(path ref(u8)) i32 :: "RemoveDirectoryA"
	extern def DeleteFileA(path ref(u8)) i32 :: "DeleteFileA"
	extern def FindFirstFileA(pattern ref(u8), data ref(void)) ref(void) :: "FindFirstFileA"
	extern def FindNextFileA(handle ref(void), data ref(void)) i32 :: "FindNextFileA"
	extern def FindClose(handle ref(void)) i32 :: "FindClose"
	extern def CreateFileA(
		path ref(u8),
		desired_access u32,
		share_mode u32,
		security ref(void),
		creation_disposition u32,
		flags u32,
		template_file ref(void)
	) ref(void) :: "CreateFileA"
	extern def ReadFile(
		handle ref(void),
		buffer ref(void),
		bytes u32,
		read_out mut(ref(u32)),
		overlapped ref(void)
	) i32 :: "ReadFile"
	extern def WriteFile(
		handle ref(void),
		buffer ref(void),
		bytes u32,
		wrote_out mut(ref(u32)),
		overlapped ref(void)
	) i32 :: "WriteFile"
	extern def GetFileSizeEx(handle ref(void), size_out ref(void)) i32 :: "GetFileSizeEx"
	extern def CloseHandle(handle ref(void)) i32 :: "CloseHandle"

	def last_errno_message(fallback ref(u8)) ref(u8)
		return fallback
	end

	def heap_alloc(size usize) ref(u8)|error
		var mem ref(u8) = @alloc(size) as mut(ref(u8))
		if mem == none
			return error("heap allocation failed")
		end
		return mem
	end

	def allocate_line[A: allocators.BumpAllocator](
		ac ref(A),
		line ref(u8)
	) ref(u8)|error
		return copy_bytes[A](ac, line, str.len(line))
	end

	def clear_last_error() void
		SetLastError(0 as u32)
	end

	def last_error() u32
		return GetLastError()
	end

	def read_u32(ptr ref(u8), offset usize) u32
		return @deref(@add(ptr, offset) as ref(u32))
	end

	def read_i64(ptr ref(u8)) i64
		return @deref(ptr as ref(i64))
	end

	def is_dot_entry(name ref(u8)) bool
		return str.eql(name, ".") || str.eql(name, "..")
	end

	pub def remove_file(path ref(u8)) void|error
		guard (path != none) else
			return io_error[void]("got null path")
		end
		clear_last_error()
		if DeleteFileA(path) == 0
			return io_error[void](
				last_errno_message("failed to remove file")
			)
		end
	end

	pub def read_text[A: allocators.BumpAllocator](
		ac ref(A),
		path ref(u8)
	) ref(u8)|error
		clear_last_error()
		var file = CreateFileA(
			path,
			2147483648 as u32,
			1 as u32,
			none,
			3 as u32,
			128 as u32,
			none
		)

		if last_error() != 0 as u32
			return io_error[ref(u8)](
				last_errno_message("failed to open file")
			)
		end

		var size_buf ref(u8) = heap_alloc(8 as usize)?
		clear_last_error()
		if GetFileSizeEx(file, size_buf as ref(void)) == 0
			CloseHandle(file)
			@free(size_buf)
			return io_error[ref(u8)](
				last_errno_message("failed to read file size")
			)
		end

		val size i64 = read_i64(size_buf)
		@free(size_buf)

		if size < 0 || size > 4294967295 as i64
			CloseHandle(file)
			return io_error[ref(u8)]("failed to read file size")
		end

		var out ref(void) = A.alloc(ac, size as usize + 1 as usize)?
		var read_count u32 = 0 as u32

		if size > 0
			clear_last_error()
			if ReadFile(
				file,
				out,
				size as u32,
				@as_mut(@addr(read_count)),
				none
			) == 0
				CloseHandle(file)
				return io_error[ref(u8)](
					last_errno_message("failed to read file")
				)
			end
		end

		if CloseHandle(file) == 0
			return io_error[ref(u8)](
				last_errno_message("failed to close file")
			)
		end

		if read_count != size as u32
			return io_error[ref(u8)](
				last_errno_message("failed to read file")
			)
		end

		@deref(@as_mut(@add(out, read_count as usize))) = 0 as u8
		return out as ref(u8)
	end

	pub def write_text(path ref(u8), data ref(u8)) void|error
		var len_data usize = str.len(data)
		if len_data > 4294967295 as usize
			return io_error[void]("failed to write file")
		end

		clear_last_error()
		var file = CreateFileA(
			path,
			1073741824 as u32,
			0 as u32,
			none,
			2 as u32,
			128 as u32,
			none
		)

		if last_error() != 0 as u32
			return io_error[void](
				last_errno_message("failed to open file")
			)
		end

		var wrote u32 = 0 as u32

		if len_data > 0 as usize
			clear_last_error()
			if WriteFile(
				file,
				data as ref(void),
				len_data as u32,
				@as_mut(@addr(wrote)),
				none
			) == 0
				CloseHandle(file)
				return io_error[void](
					last_errno_message("failed to write file")
				)
			end
		end

		if CloseHandle(file) == 0
			return io_error[void](
				last_errno_message("failed to close file")
			)
		end

		if wrote != len_data as u32
			return io_error[void](
				last_errno_message("failed to write file")
			)
		end
	end

	pub def read_dir[A: allocators.BumpAllocator](
		ac ref(A),
		path ref(u8)
	) list[DirEntry]|error
		if !is_dir(path)
			return io_error[list[DirEntry]]("failed to read directory")
		end

		var pattern = join[A](ac, path, "*")?
		var entries list[DirEntry] = []
		var data ref(u8) = heap_alloc(592 as usize)?

		clear_last_error()
		var handle = FindFirstFileA(pattern, data as ref(void))
		var err u32 = last_error()

		if err != 0 as u32
			@free(data)

			if err == 2 as u32
				return entries
			end

			return io_error[list[DirEntry]]("failed to read directory")
		end

		var keep_going bool = true

		for keep_going
			var name ref(u8) = @add(data, 44 as usize)
			if !is_dot_entry(name)
				var attrs u32 = read_u32(data, 0 as usize)
				var kind_dir bool = (attrs & 16 as u32) != 0 as u32
				var name_copy = allocate_line[A](ac, name)?
				var full_path = join[A](ac, path, name_copy)?

				@append(
					entries,
					DirEntry(
						name: name_copy,
						path: full_path,
						is_file: !kind_dir,
						is_dir: kind_dir
					)
				)
			end

			clear_last_error()
			if FindNextFileA(handle, data as ref(void)) == 0
				err = last_error()
				if err == 18 as u32
					keep_going = false
				else
					FindClose(handle)
					@free(data)
					return io_error[list[DirEntry]]("failed to read directory")
				end
			end
		end

		@free(data)

		if FindClose(handle) == 0
			return io_error[list[DirEntry]]("failed to read directory")
		end

		return entries
	end

	pub def create_dir(path ref(u8)) void|error
		clear_last_error()
		if CreateDirectoryA(path, none) == 0
			return io_error[void](
				last_errno_message("failed to create directory")
			)
		end
	end

	pub def create_dir_all(path ref(u8)) void|error
		guard path != none && str.len(path) > 0 as usize else
			return io_error[void]("failed to create directory")
		end

		if exists(path)
			if is_dir(path)
				return
			end
			return io_error[void]("failed to create directory")
		end

		var ac = allocators.Arena.new(4096 as usize)?
		var parent = dirname[_](@addr(ac), path)?

		if (
			parent != none &&
			!str.eql(parent, ".") &&
			!str.eql(parent, path)
		)
			create_dir_all(parent)?
		end

		create_dir(path)?
		allocators.Arena.destroy(@addr(ac))
	end

	pub def remove_dir(path ref(u8)) void|error
		clear_last_error()
		if RemoveDirectoryA(path) == 0
			return io_error[void](
				last_errno_message("failed to remove directory")
			)
		end
	end

	pub def remove_dir_all(path ref(u8)) void|error
		if path == none || !exists(path)
			return
		end

		if is_file(path)
			return remove_file(path)
		end

		var ac = allocators.Arena.new(16384 as usize)?
		var entries = read_dir[_](@addr(ac), path)?

		for var entry in entries
			if entry.is_dir
				remove_dir_all(entry.path)?
			else
				remove_file(entry.path)?
			end
		end

		allocators.Arena.destroy(@addr(ac))
		remove_dir(path)?
	end

	pub def exists(path ref(u8)) bool
		guard path != none else
			return false
		end

		clear_last_error()
		GetFileAttributesA(path)
		return last_error() == 0 as u32
	end

	pub def is_file(path ref(u8)) bool
		guard path != none else
			return false
		end

		clear_last_error()
		var attrs = GetFileAttributesA(path)

		if last_error() != 0 as u32
			return false
		end

		return (attrs & 16 as u32) == 0 as u32
	end

	pub def is_dir(path ref(u8)) bool
		guard path != none else
			return false
		end

		clear_last_error()
		var attrs = GetFileAttributesA(path)

		if last_error() != 0 as u32
			return false
		end

		return (attrs & 16 as u32) != 0 as u32
	end
end

when redox
	pub def read_text[A: allocators.BumpAllocator](
		ac ref(A),
		path ref(u8)
	) ref(u8)|error
		return unsupported_fs[ref(u8)]()
	end

	pub def write_text(path ref(u8), data ref(u8)) void|error
		return unsupported_fs[void]()
	end

	pub def read_dir[A: allocators.BumpAllocator](
		ac ref(A),
		path ref(u8)
	) list[DirEntry]|error
		return unsupported_fs[list[DirEntry]]()
	end

	pub def create_dir(path ref(u8)) void|error
		return unsupported_fs[void]()
	end

	pub def create_dir_all(path ref(u8)) void|error
		return unsupported_fs[void]()
	end

	pub def remove_dir(path ref(u8)) void|error
		return unsupported_fs[void]()
	end

	pub def remove_dir_all(path ref(u8)) void|error
		return unsupported_fs[void]()
	end

	pub def remove_file(path ref(u8)) void|error
		return unsupported_fs[void]()
	end

	pub def exists(path ref(u8)) bool
		return false
	end

	pub def is_file(path ref(u8)) bool
		return false
	end

	pub def is_dir(path ref(u8)) bool
		return false
	end
end

test "path helpers work"
	var ac = allocators.Arena.new(4096 as usize)?

	when posix
		assert str.eql(
			join[_](@addr(ac), "tmp/fs", "note.txt")?,
			"tmp/fs/note.txt"
		)
		assert str.eql(
			dirname[_](@addr(ac), "tmp/fs/note.txt")?,
			"tmp/fs"
		)
		assert str.eql(
			basename[_](@addr(ac), "tmp/fs/note.txt")?,
			"note.txt"
		)
		assert str.eql(
			extension[_](@addr(ac), "tmp/fs/note.txt")?,
			"txt"
		)
		assert str.eql(
			strip_extension[_](@addr(ac), "tmp/fs/note.txt")?,
			"tmp/fs/note"
		)
		assert is_absolute("/tmp/fs")
		assert !is_absolute("tmp/fs")
	end

	when windows
		assert str.eql(
			join[_](@addr(ac), "tmp\\fs", "note.txt")?,
			"tmp\\fs\\note.txt"
		)
		assert str.eql(
			dirname[_](@addr(ac), "tmp\\fs\\note.txt")?,
			"tmp\\fs"
		)
		assert str.eql(
			basename[_](@addr(ac), "tmp\\fs\\note.txt")?,
			"note.txt"
		)
		assert str.eql(
			extension[_](@addr(ac), "tmp\\fs\\note.txt")?,
			"txt"
		)
		assert str.eql(
			strip_extension[_](@addr(ac), "tmp\\fs\\note.txt")?,
			"tmp\\fs\\note"
		)
		assert is_absolute("C:\\tmp\\fs")
		assert !is_absolute("tmp\\fs")
	end

	allocators.Arena.destroy(@addr(ac))
end

when posix
	test "read and write text work"
		var ac = allocators.Arena.new(8192 as usize)?
		var root = join[_](@addr(ac), "scar-out", "fs-tests-text")?
		var file = join[_](@addr(ac), root, "hello.txt")?

		if exists(root)
			remove_dir_all(root)?
		end

		create_dir_all(root)?
		write_text(file, "hello from scar")?

		assert exists(file)
		assert is_file(file)
		assert str.eql(
			read_text[_](@addr(ac), file)?,
			"hello from scar"
		)

		remove_dir_all(root)?
		assert !exists(root)

		allocators.Arena.destroy(@addr(ac))
	end

	test "read_dir reports files and directories"
		var ac = allocators.Arena.new(16384 as usize)?
		var root = join[_](@addr(ac), "scar-out", "fs-tests-dir")?
		var child_dir = join[_](@addr(ac), root, "child")?
		var file = join[_](@addr(ac), root, "note.txt")?

		if exists(root)
			remove_dir_all(root)?
		end

		create_dir_all(child_dir)?
		write_text(file, "hello")?

		val entries = read_dir[_](@addr(ac), root)?
		var saw_dir bool = false
		var saw_file bool = false
		var count i32 = 0

		for var entry in entries
			count++

			if entry.is_dir && str.eql(entry.name, "child")
				saw_dir = true
				assert str.eql(entry.path, child_dir)
			end

			if entry.is_file && str.eql(entry.name, "note.txt")
				saw_file = true
				assert str.eql(entry.path, file)
			end
		end

		assert count == 2
		assert saw_dir
		assert saw_file

		remove_dir_all(root)?
		allocators.Arena.destroy(@addr(ac))
	end
end
